{
  "slug": "interpreter",
  "title": "Build your own Interpreter",
  "tagline": "Implemente uma linguagem de programação inteira: do scanner às classes com herança.",
  "description": "Você vai construir em Java um interpretador tree-walk para Lox, a linguagem do livro Crafting Interpreters (Robert Nystrom): scanner, parser descendente recursivo, avaliação de expressões com erros de execução, variáveis e escopos, controle de fluxo, funções de primeira classe e closures, resolução estática, classes, construtores, herança e super. São 84 stages.",
  "language": "java",
  "languageLabel": "Java 21",
  "estimatedHours": 35,
  "topics": [
    "análise léxica",
    "parsing",
    "AST",
    "interpretação tree-walk",
    "escopos e ambientes",
    "closures",
    "resolução estática",
    "classes e herança"
  ],
  "prerequisites": [
    "Java 21 instalado (java -version)",
    "Maven instalado (mvn -version)"
  ],
  "runtime": {
    "starter": "challenges/interpreter/starter/java",
    "reference": "challenges/interpreter/java",
    "runner": "challenges/interpreter/tests/stages.mjs",
    "compile": {
      "command": "mvn",
      "args": [
        "-q",
        "-B",
        "package"
      ],
      "timeoutMs": 240000
    },
    "runCommand": "./your_program.sh <tokenize|parse|evaluate|run> <arquivo.lox>"
  },
