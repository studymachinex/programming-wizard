{
  "slug": "redis",
  "title": "Build your own Redis",
  "tagline": "Construa um servidor compatível com o Redis: do PING à replicação e persistência.",
  "description": "Você vai construir em Java um servidor que fala o protocolo do Redis (RESP): strings com expiração, listas com BLPOP, streams com XREAD bloqueante, transações e WATCH, replicação master/réplica com WAIT, leitura de RDB, persistência AOF, pub/sub, sorted sets, bitmaps, comandos geoespaciais e autenticação com ACL. O tester simula clientes, masters e réplicas. São 124 stages.",
  "language": "java",
  "languageLabel": "Java 21",
  "estimatedHours": 45,
  "topics": [
    "protocolo RESP",
    "servidor TCP concorrente",
    "estruturas de dados",
    "operações bloqueantes",
    "transações",
    "replicação",
    "persistência (RDB/AOF)",
    "pub/sub",
    "geohash",
    "autenticação"
  ],
  "prerequisites": [
    "Java 21 instalado (java -version)",
    "Maven instalado (mvn -version)"
  ],
  "runtime": {
    "starter": "challenges/redis/starter/java",
    "reference": "challenges/redis/java",
    "runner": "challenges/redis/tests/stages.mjs",
    "compile": {
      "command": "mvn",
      "args": [
        "-q",
        "-B",
        "package"
      ],
      "timeoutMs": 240000
    },
    "runCommand": "./your_program.sh --port <porta> [--replicaof \"host porta\"] [--dir d --dbfilename f] [--appendonly yes]"
  },
